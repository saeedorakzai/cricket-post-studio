# AI provider for planning slides: claude or gemini
AI_PROVIDER=claude

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Shown as a watermark on every slide
PAGE_HANDLE=@YourCricketPage
# Optional path to a PNG logo (transparent background works best)
LOGO_PATH=

# Default accent colour (hex)
ACCENT_COLOR=#00C853
